#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
#
# hixctl: the small host-side control panel for hix.
#
#   scripts/hixctl build [make args...]
#   scripts/hixctl run [--serial] [--no-build]
#   scripts/hixctl show
#   scripts/hixctl set KEY VALUE
#   scripts/hixctl splash on|off|seconds N
#   scripts/hixctl quiet on|off
#   scripts/hixctl screensaver NAME|timeout N
#   scripts/hixctl edit
#   scripts/hixctl check
#   scripts/hixctl reset [-y]
#   scripts/hixctl doctor
#
# The values live in config/hix.conf and are compiled into the kernel as
# build/hixconfig.h. This is the host-side "bash customization" layer; the
# guest itself has no bash (see docs/CRYPTO.md and docs/ROADMAP.md).
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CONF=${HIX_CONF:-"$ROOT/config/hix.conf"}
BUILD="$ROOT/build"

die()
{
	echo "hixctl: $*" >&2
	exit 1
}

usage()
{
	sed -n '4,16p' "$0" | sed 's/^# \{0,1\}//'
}

trim()
{
	local s=$1
	s=${s#"${s%%[![:space:]]*}"}
	s=${s%"${s##*[![:space:]]}"}
	printf '%s' "$s"
}

conf_value()
{
	local key=$1 val

	[ -f "$CONF" ] || return 0
	while IFS= read -r line; do
		line=${line%%#*}
		[ -n "$(trim "$line")" ] || continue
		[ "${line%%=*}" != "$line" ] || continue
		if [ "$(trim "${line%%=*}")" = "$key" ]; then
			val=$(trim "${line#*=}")
			printf '%s' "$val"
			return 0
		fi
	done < "$CONF"
}

gen_config()
{
	local input=${1:-"$CONF"} output=${2:--}
	local splash=on seconds=2 quiet=on sa=stars timeout=120
	local line key val

	[ -f "$input" ] || die "no config file: $input"
	while IFS= read -r line; do
		line=${line%%#*}
		[ -n "$(trim "$line")" ] || continue
		[ "${line%%=*}" != "$line" ] || continue
		key=$(trim "${line%%=*}")
		val=$(trim "${line#*=}")
		case "$key" in
		splash) splash=$val ;;
		splash_seconds) seconds=$val ;;
		quiet) quiet=$val ;;
		screensaver) sa=$val ;;
		screensaver_timeout) timeout=$val ;;
		*) die "unknown key '$key' in $input" ;;
		esac
	done < "$input"

	case "$splash" in on|yes|1) splash=1 ;; off|no|0) splash=0 ;; *) die "splash must be on/off" ;; esac
	case "$quiet" in on|yes|1) quiet=1 ;; off|no|0) quiet=0 ;; *) die "quiet must be on/off" ;; esac
	case "$seconds" in ''|*[!0-9]*) die "splash_seconds must be a number" ;; esac
	case "$timeout" in ''|*[!0-9]*) die "screensaver_timeout must be a number" ;; esac
	case "$sa" in stars|matrix|clock|blank) ;; *) die "screensaver must be stars, matrix, clock or blank" ;; esac

	if [ "$output" = - ]; then
		exec 3>&1
	else
		mkdir -p "$(dirname -- "$output")"
		exec 3>"$output"
	fi
	cat >&3 <<EOF
/* generated by scripts/hixctl from config/hix.conf -- do not edit */
#ifndef _HIX_GENERATED_CONFIG_H
#define _HIX_GENERATED_CONFIG_H
#define HIX_CONFIG_SPLASH		$splash
#define HIX_CONFIG_SPLASH_SECONDS	$seconds
#define HIX_CONFIG_QUIET		$quiet
#define HIX_CONFIG_SCREENSAVER		"$sa"
#define HIX_CONFIG_SCREENSAVER_TIMEOUT	$timeout
#endif
EOF
	exec 3>&-
}

set_key()
{
	local key=$1 value=$2 tmp found=0 line

	[ -f "$CONF" ] || die "no config file: $CONF"
	tmp=$(mktemp)
	while IFS= read -r line; do
		if [ "$(trim "${line%%=*}")" = "$key" ] &&
		   [ "${line%%=*}" != "$line" ]; then
			printf '%s = %s\n' "$key" "$value"
			found=1
		else
			printf '%s\n' "$line"
		fi
	done < "$CONF" > "$tmp"
	if [ "$found" = 0 ]; then
		printf '%s = %s\n' "$key" "$value" >> "$tmp"
	fi
	mv "$tmp" "$CONF"
}

valid_value()
{
	case "$1" in
	splash|quiet)
		case "$2" in on|off) return 0 ;; esac
		return 1
		;;
	splash_seconds|screensaver_timeout)
		case "$2" in ''|*[!0-9]*) return 1 ;; esac
		return 0
		;;
	screensaver)
		case "$2" in stars|matrix|clock|blank) return 0 ;; esac
		return 1
		;;
	esac
	return 1
}

cmd_set()
{
	[ $# -eq 2 ] || die "usage: hixctl set KEY VALUE"
	valid_value "$1" "$2" || die "bad value for $1: $2"
	set_key "$1" "$2"
}

cmd_edit()
{
	"${EDITOR:-vi}" "$CONF"
	cmd_check
}

cmd_check()
{
	gen_config "$CONF" /dev/null
	echo "hixctl: $CONF is valid"
}

cmd_reset()
{
	local answer

	if [ "${1:-}" != "-y" ] && [ "${1:-}" != "--yes" ]; then
		printf 'hixctl: overwrite %s with defaults? [y/N] ' "$CONF"
		read -r answer || true
		case "$answer" in y|Y|yes|YES) ;; *) echo "cancelled"; return 0 ;; esac
	fi
	cat > "$CONF" <<'EOF'
# hix boot experience. Edit this file and run `make` (or scripts/hixctl build).
#
# splash          on/off  show the boot screen before the shell
# splash_seconds  number  how long the boot screen stays up
# quiet           on/off  keep driver info out of the VGA console (dmesg keeps it)
# screensaver     name    stars, matrix, clock, blank
# screensaver_timeout     idle seconds before the screensaver starts (0 = off)

splash = on
splash_seconds = 2
quiet = on
screensaver = stars
screensaver_timeout = 120
EOF
	echo "hixctl: wrote default $CONF"
}

cmd_build()
{
	make -C "$ROOT" "$@"
}

cmd_run()
{
	local serial=0 nobuild=0

	while [ $# -gt 0 ]; do
		case "$1" in
		--serial) serial=1 ;;
		--no-build) nobuild=1 ;;
		*) die "run: unknown option $1" ;;
		esac
		shift
	done
	[ "$nobuild" = 0 ] && make -C "$ROOT"
	local qemu=(qemu-system-i386 -m 128M -kernel "$BUILD/hix.elf")
	[ "$serial" = 1 ] && qemu+=(-serial stdio)
	"${qemu[@]}"
}

cmd_doctor()
{
	local fail=0

	for tool in gcc g++ ld nasm python3; do
		if command -v "$tool" >/dev/null 2>&1; then
			echo "ok   $tool"
		else
			echo "MISS $tool"; fail=1
		fi
	done
	if command -v qemu-system-i386 >/dev/null 2>&1; then
		echo "ok   qemu-system-i386"
	else
		echo "MISS qemu-system-i386 (only needed for run)"; fail=1
	fi
	if "$ROOT/scripts/rust-available.sh" >/dev/null 2>&1; then
		echo "ok   Rust i686 core"
	else
		echo "info Rust i686 core not found (make RUST=0 still builds)"
	fi
	if python3 -c 'import cryptography' >/dev/null 2>&1; then
		echo "ok   Python cryptography (make crypto-test)"
	else
		echo "info Python cryptography missing (only needed for crypto-test)"
	fi
	return "$fail"
}

case "${1:-}" in
build|"")
	shift || true
	cmd_build "$@"
	;;
run)
	shift
	cmd_run "$@"
	;;
show)
	cat "$CONF"
	;;
set)
	shift
	cmd_set "$@"
	;;
splash)
	cmd=${2:-show}
	case "$cmd" in
	on|off) set_key splash "$cmd" ;;
	seconds)
		if [ $# -eq 3 ]; then
			set_key splash_seconds "$3"
		elif [ $# -eq 2 ]; then
			conf_value splash_seconds; echo
		else
			die "usage: hixctl splash seconds [N]"
		fi
		;;
	show) conf_value splash; echo ;;
	*) die "usage: hixctl splash on|off|seconds [N]" ;;
	esac
	;;
quiet)
	cmd=${2:-show}
	case "$cmd" in
	on|off) set_key quiet "$cmd" ;;
	show) conf_value quiet; echo ;;
	*) die "usage: hixctl quiet on|off" ;;
	esac
	;;
screensaver)
	cmd=${2:-show}
	case "$cmd" in
	stars|matrix|clock|blank) set_key screensaver "$cmd" ;;
	timeout)
		if [ $# -eq 3 ]; then
			set_key screensaver_timeout "$3"
		elif [ $# -eq 2 ]; then
			conf_value screensaver_timeout; echo
		else
			die "usage: hixctl screensaver timeout [N]"
		fi
		;;
	show) conf_value screensaver; echo ;;
	*) die "usage: hixctl screensaver NAME|timeout [N]" ;;
	esac
	;;
edit)
	cmd_edit
	;;
check)
	cmd_check
	;;
reset)
	shift || true
	cmd_reset "$@"
	;;
gen-config)
	[ $# -ge 2 ] || die "usage: hixctl gen-config INPUT [OUTPUT]"
	gen_config "$2" "${3:--}"
	;;
doctor)
	cmd_doctor
	;;
help|-h|--help)
	usage
	;;
*)
	die "unknown command '$1' (try hixctl help)"
	;;
esac
